# Copy to .env. Compose binds to loopback by default; no Jetson address is assumed.
FRONTEND_PORT=8080
BACKEND_PORT=8000
DEV_FRONTEND_PORT=5173
VITE_DATA_MODE=demo
PBL6_DATA_MODE=demo
PBL6_ROBOT_NAME=PBL6-01
# Keep origins in JSON. Add the actual browser origin if you change ports.
PBL6_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
# Vite dev uses a same-origin proxy to 127.0.0.1:8000.
# For a separately hosted frontend, set these in frontend/.env.local, then rebuild:
# VITE_API_BASE_URL=https://your-verified-backend.example
# VITE_WS_URL=wss://your-verified-backend.example/ws/telemetry
